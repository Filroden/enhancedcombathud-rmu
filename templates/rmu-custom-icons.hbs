<form autocomplete="off" style="padding: 10px; display: flex; flex-direction: column; gap: 10px;">
    <p class="notes" style="margin-bottom: 10px;">
        Map specific skill or spell names to an icon. Enter the exact name (e.g. "Fire Bolt" or "Perception").
    </p>

    <div style="max-height: 400px; overflow-y: auto; padding-right: 5px; display: flex; flex-direction: column; gap: 5px;">
        {{#each icons}}
            <div class="form-group" data-row-id="{{this.id}}" style="display: flex; gap: 5px; align-items: center; margin: 0;">
                <input type="text" name="name_{{this.id}}" value="{{this.name}}" placeholder="Name (e.g., Perception)" style="flex: 2; height: 28px;" />

                <div style="display: flex; flex: 3; gap: 5px; align-items: center;">
                    <input type="text" name="path_{{this.id}}" value="{{this.path}}" placeholder="Icon Path" style="flex: 1; height: 28px;" />
                    <button type="button" data-action="pickFile" data-target="path_{{this.id}}" title="Browse Files" style="flex: 0 0 32px; height: 28px; padding: 0; line-height: 1;">
                        <i class="fas fa-file-import fa-fw"></i>
                    </button>
                    <button type="button" data-action="deleteRow" title="Remove" style="flex: 0 0 32px; height: 28px; padding: 0; line-height: 1; color: darkred;">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        {{/each}}
    </div>

    <div class="form-group" style="margin-top: 5px;">
        <button type="button" data-action="addRow" style="width: auto; padding: 0 15px;">
            <i class="fas fa-plus"></i>
            Add Icon Map
        </button>
    </div>

    <footer class="form-footer" style="display: flex; justify-content: flex-end; gap: 10px; margin-top: 10px; border-top: 1px solid var(--color-border-light-2); padding-top: 10px;">
        <button type="button" data-action="cancel" style="width: auto; padding: 0 15px;">
            <i class="fas fa-times"></i>
            Cancel
        </button>
        <button type="button" data-action="save" style="width: auto; padding: 0 15px;">
            <i class="fas fa-save"></i>
            Save Changes
        </button>
    </footer>
</form>