{{!--
    Custom spell and skill icon editor.
    The application itself is the <form> element (ApplicationV2 with tag "form"), so this
    template's root is a plain wrapper. Each row's inputs are named by the row's random id
    (name_<id>, path_<id>) so rows stay distinct while names are blank or duplicated.
--}}
<div class="ech-rmu-custom-icons">
    <p class="notes ech-rmu-custom-icons__intro">
        {{localize "ECH-RMU.CustomIcons.Intro"}}
    </p>

    <div class="ech-rmu-custom-icons__rows">
        {{#each icons}}
            <div class="form-group ech-rmu-custom-icons__row" data-row-id="{{this.id}}">
                <input type="text" class="ech-rmu-custom-icons__name" name="name_{{this.id}}" value="{{this.name}}" placeholder="{{localize 'ECH-RMU.CustomIcons.NamePlaceholder'}}" />

                <div class="ech-rmu-custom-icons__path-group">
                    <input type="text" class="ech-rmu-custom-icons__path" name="path_{{this.id}}" value="{{this.path}}" placeholder="{{localize 'ECH-RMU.CustomIcons.PathPlaceholder'}}" />
                    <button type="button" class="ech-rmu-custom-icons__icon-button" data-action="pickFile" data-target="path_{{this.id}}" title="{{localize 'ECH-RMU.CustomIcons.Browse'}}">
                        <i class="fas fa-file-import fa-fw"></i>
                    </button>
                    <button type="button" class="ech-rmu-custom-icons__icon-button ech-rmu-custom-icons__delete" data-action="deleteRow" title="{{localize 'ECH-RMU.CustomIcons.Remove'}}">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        {{/each}}
    </div>

    <div class="form-group ech-rmu-custom-icons__add">
        <button type="button" class="ech-rmu-custom-icons__text-button" data-action="addRow">
            <i class="fas fa-plus"></i>
            {{localize "ECH-RMU.CustomIcons.Add"}}
        </button>
    </div>

    <footer class="form-footer ech-rmu-custom-icons__footer">
        <button type="button" class="ech-rmu-custom-icons__text-button" data-action="cancel">
            <i class="fas fa-times"></i>
            {{localize "ECH-RMU.CustomIcons.Cancel"}}
        </button>
        <button type="submit" class="ech-rmu-custom-icons__text-button">
            <i class="fas fa-save"></i>
            {{localize "ECH-RMU.CustomIcons.Save"}}
        </button>
    </footer>
</div>
